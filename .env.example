
NEXT_PUBLIC_LEARN_MORE=https://learnmore.com

# VIEW MODE - Override wallet address for testing
NEXT_PUBLIC_IS_VIEW=false
NEXT_PUBLIC_VIEW_ADDRESS=0x92C891Fa3Bf12e02722F4504167CE8F20FB7860F

# NETWORK - Switch between local/testnet/mainnet
NEXT_PUBLIC_ENABLE_LOCALNETS=false
NEXT_PUBLIC_ENABLE_TESTNETS=true

# WALLETCONNECT - For wallet connections
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=55a78215268b7084645bd8fcfb904d6e
NEXT_PUBLIC_APP_NAME=My DApp

# CONTRACT ADDRESSES - ERC20
NEXT_PUBLIC_ERC20_ADDRESS_LOCAL=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
NEXT_PUBLIC_ERC20_ADDRESS_TEST=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ERC20_ADDRESS_MAIN=0x0000000000000000000000000000000000000000

# SUBGRAPH URLS - Per network
NEXT_PUBLIC_LOCALNET_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/my-subgraph
NEXT_PUBLIC_TESTNET_SUBGRAPH_URL=https://api.studio.thegraph.com/query/YOUR_QUERY_ID/YOUR_SUBGRAPH/VERSION
NEXT_PUBLIC_MAINNET_SUBGRAPH_URL=https://gateway.thegraph.com/api/YOUR_API_KEY/subgraphs/id/YOUR_SUBGRAPH_ID





